# Reference list of the environment variables this CLI reads. Nothing loads a
# .env file automatically: the settings layer reads os.environ directly, so
# export these in your shell (or copy this file to a git-ignored .env and load
# it yourself, e.g. `set -a; . ./.env; set +a`). Values here are placeholders.
# These variables belong to the optional model-provider layer; delete this
# file if you remove that layer.

# Vendor credentials, read by the provider SDKs when `check --provider
# anthropic|openai` uses a real model.
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Runtime knobs read by spec_drift.config.settings (all optional).
SPEC_DRIFT_PROVIDER=echo
SPEC_DRIFT_MODEL=
# Mechanical context bound: a governed change whose diff plus governing
# documents exceed this many characters is reported as insufficient-evidence
# instead of being silently truncated. Defaults to 400000.
SPEC_DRIFT_MAX_CONTEXT_CHARS=
